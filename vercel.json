{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.danosaparentes.com.br" }],
      "destination": "https://danosaparentes.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.danosaparentes.com.br" }],
      "destination": "https://danosaparentes.com.br/:path*",
      "permanent": true
    }
  ]
}
