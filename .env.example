# ─── Supabase (públicas — expostas ao cliente) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Legado (opcional — APIs server-side ainda leem como fallback):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─── Supabase (servidor — NÃO expor) ─────────────────────────
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ─── ElevenLabs (narração TTS — servidor) ────────────────────
ELEVENLABS_API_KEY=sua-chave-elevenlabs-aqui

# ─── Google Cloud Text-to-Speech (vozes PT-BR — servidor) ───
GOOGLE_TTS_API_KEY=sua-chave-google-tts-aqui

# ─── WDAPI (consulta automática de placas — servidor) ────────
WDAPI_TOKEN=seu-token-wdapi-aqui

# ─── Stripe (assinatura — servidor) ──────────────────────────
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Price ID do plano Starter (20 laudos/mês). Usado pelo checkout de cartão
# (/api/create-checkout-session?plan=starter) e pelo webhook para marcar a
# assinatura como plan_tier='starter'.
STRIPE_PRICE_ID_STARTER=price_...
# Price ID usado nas vendas do plano Corporativo (fechadas via WhatsApp/consultivo
# ou Payment Link manual no Stripe). O webhook usa este ID pra marcar a assinatura
# como plan_tier='corporativo' e liberar o dashboard de equipe.
STRIPE_PRICE_ID_CORPORATE=price_...

# ─── Analytics de conversão (Meta + TikTok — públicas) ───────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# ─── Mercado Pago (PIX – servidor) ───────────────────────
PIX_MERCADO_PAGO_ACCESS_TOKEN=SEU_TOKEN_AQUI
# Secret de assinatura do webhook (painel MP → Webhooks)
PIX_WEBHOOK_SECRET=seu-secret-webhook-aqui

# ─── Asaas (PIX sandbox/produção – servidor) ─────────────
# Sandbox: https://sandbox.asaas.com → Integrações → API Key
# API: https://api-sandbox.asaas.com  |  Produção: https://api.asaas.com
ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com
# Token configurado no webhook Asaas (header asaas-access-token)
# URL do webhook: {NEXT_PUBLIC_BASE_URL}/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=
# CPF/CNPJ usado ao criar cliente Asaas se o usuário não tiver documento (sandbox)
# ASAAS_DEFAULT_CPF=24971563792
# Provedor padrão na API se a UI não passar ?provider= (asaas | mercadopago)
# PIX_PROVIDER=asaas

# URL pública do app (PIX webhook, Stripe success/cancel/portal return, links absolutos)
NEXT_PUBLIC_BASE_URL=https://danosaparentes.com.br

# Links de assinatura remota (HMAC). Obrigatório em produção — não reutilize SERVICE_ROLE_KEY.
# Gere com: openssl rand -hex 32
SIGNATURE_LINK_SECRET=

# Rate limit distribuído (opcional — Upstash Redis REST ou Vercel KV)
# Sem estas vars, rotas sensíveis usam limite em memória (por instância).
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Vercel KV (mesma API REST — use um par OU o outro):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── Gemini (IA de vistoria — servidor) ──────────────────
GEMINI_API_KEY=sua-chave-gemini-aqui
# Modelo para análise de fotos (/api/damage-vision, /api/damage-vision-bulk)
# Padrão recomendado: gemini-2.5-flash (fallback automático → gemini-2.0-flash)
# Se GEMINI_VISION_MODEL=gemini-2.5-pro estiver na Vercel e falhar, a cadeia
# tenta os flash em seguida — mas o ideal é remover a var ou usar flash.
# GEMINI_VISION_MODEL=gemini-2.5-flash

# ─── Groq (classificação de dano por foto — /api/damage-classify) ───
GROQ_API_KEY=sua-chave-groq-aqui

# Connection string Postgres (npm run db:push) — Settings → Database → URI
# SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
