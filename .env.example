# ─── Supabase (públicas — expostas ao cliente) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Legado (opcional — APIs server-side ainda leem como fallback):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─── Supabase (servidor — NÃO expor) ─────────────────────────
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# ─── ElevenLabs (narração TTS — servidor) ────────────────────
ELEVENLABS_API_KEY=sua-chave-elevenlabs-aqui

# ─── Google Cloud Text-to-Speech (vozes PT-BR — servidor) ───
GOOGLE_TTS_API_KEY=sua-chave-google-tts-aqui

# ─── WDAPI (consulta automática de placas — servidor) ────────
WDAPI_TOKEN=seu-token-wdapi-aqui

# ─── Stripe (assinatura cartão — servidor) ───────────────────
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
# Price ID usado nas vendas do plano Corporativo (fechadas via WhatsApp/consultivo
# ou Payment Link manual no Stripe). O webhook usa este ID pra marcar a assinatura
# como plan_tier='corporativo' e liberar o dashboard de equipe.
STRIPE_PRICE_ID_CORPORATE=price_...

# ─── Mercado Pago PIX (assinatura sem cartão — servidor) ─────
# Access Token da aplicação (Payments API). Sem ele o QR não é gerado.
PIX_MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
# Secret do webhook (x-signature). Cadastre a URL https://SEU-DOMINIO/api/pix-webhook
PIX_WEBHOOK_SECRET=
# Preço de 1 unidade/mês do Pro em R$ (default 49.90)
PIX_PRO_UNIT_AMOUNT=49.90

# ─── Analytics de conversão (Meta + TikTok — públicas) ───────
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false
